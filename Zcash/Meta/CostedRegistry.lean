import Lean

/-!
# The registry of `Costed` instances

The registry records every `Costed` instance that the derivation of a cost function may use,
with its provenance, which is what makes the trusted base determinable. It lives in a module of
its own because an environment extension cannot be used in the module that declares it, and
`Zcash.Meta.Instrument` fills it with the built-in instances as soon as it is imported.
-/

open Lean

namespace Zcash.Meta.CostedRegistry

/-- Where a `Costed` instance comes from, which decides what it asserts. -/
inductive Provenance where
  /-- One of the structural instances of `Zcash.Meta.Costed`: the primitive first-order types,
  function types, and the parametric inductives that are their own mirrors. -/
  | builtin
  /-- Generated by the derivation for an inductive type, after reading its constructors. -/
  | generated
  /-- Written by hand and registered with `register_costed`: a trusted assumption about cost. -/
  | registered
  deriving Inhabited, Repr, BEq

/-- The provenance, in words, for a message. -/
def Provenance.describe : Provenance → String
  | .builtin => "built in"
  | .generated => "generated"
  | .registered => "hand-written"

/-- A registered `Costed` instance: the instance's declaration and where it comes from. -/
structure CostedEntry where
  inst : Name
  provenance : Provenance
  deriving Inhabited, Repr

/-- The registry of `Costed` instances, by the instance's declaration. -/
initialize costedExt : SimplePersistentEnvExtension CostedEntry (NameMap CostedEntry) ←
  registerSimplePersistentEnvExtension {
    addEntryFn := fun m e => m.insert e.inst e
    addImportedFn := fun ess => ess.foldl (fun m es => es.foldl (fun m e => m.insert e.inst e) m) {}
  }

/-- The registry entry of the instance `inst`, if any. -/
def costedEntry? (env : Environment) (inst : Name) : Option CostedEntry :=
  (costedExt.getState env).find? inst

/-- A registered instrumented function: `inst` takes the costed forms of `fn`'s binders and
returns the cost of a call with the costed form of its result. `registered` says that it was
written by hand, a trusted assumption about cost, rather than derived. -/
structure InstEntry where
  fn : Name
  inst : Name
  registered : Bool
  deriving Inhabited, Repr

/-- The registry of instrumented functions, by the function. -/
initialize instExt : SimplePersistentEnvExtension InstEntry (NameMap InstEntry) ←
  registerSimplePersistentEnvExtension {
    addEntryFn := fun m e => m.insert e.fn e
    addImportedFn := fun ess => ess.foldl (fun m es => es.foldl (fun m e => m.insert e.fn e) m) {}
  }

/-- The registry entry of the function `fn`, if any. -/
def instEntry? (env : Environment) (fn : Name) : Option InstEntry :=
  (instExt.getState env).find? fn

/-- The instrumented functions whose derivation failed in this module, with the reason, so that
a second attempt repeats the reason rather than the leftover declaration. -/
initialize failedInstExt : EnvExtension (NameMap String) ← registerEnvExtension (pure {})

/-- How a generated mirror lays out the fields of each constructor of the original type: for
each original field, the number of fields of the mirror that represent it. One field holds the
field's costed form. Three hold a function field whose result holds the type being mirrored:
the function, the cost of a call, and the costed form of its result, as separate fields rather
than the pair that a function's costed form is otherwise, so that the mirror does not occur
nested in a pair, which structural recursion over it could not see through. -/
structure MirrorInfo where
  original : Name
  mirror : Name
  layout : Array (Array Nat)
  deriving Inhabited, Repr

/-- The registry of generated mirrors, by the mirror's name. -/
initialize mirrorExt : SimplePersistentEnvExtension MirrorInfo (NameMap MirrorInfo) ←
  registerSimplePersistentEnvExtension {
    addEntryFn := fun m e => m.insert e.mirror e
    addImportedFn := fun ess =>
      ess.foldl (fun m es => es.foldl (fun m e => m.insert e.mirror e) m) {}
  }

/-- The layout of the mirror `mirror`, if it is a generated one. -/
def mirrorInfo? (env : Environment) (mirror : Name) : Option MirrorInfo :=
  (mirrorExt.getState env).find? mirror

end Zcash.Meta.CostedRegistry
