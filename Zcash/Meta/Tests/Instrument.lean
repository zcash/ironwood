import Zcash.Meta.Instrument

/-! Tests of the `Costed` registry: the built-in instances resolve and are first order where
they should be; a hand-written instance is refused until registered, and reported once it is;
a first-order inductive type gets its identity instance generated. -/

namespace Zcash.Meta.Tests.Instrument

open Lean Elab Term Meta Zcash.Meta.Instrument Zcash.Meta.CostedRegistry

/-- info: first order: true, trusted: [] -/
#guard_msgs in
run_elab do
  let t ← elabType (← `(List (Nat × Option Bool)))
  let (_, trusted) ← costedInstance t
  logInfo m!"first order: {← isFirstOrder t}, trusted: {trusted}"

/-- info: first order: false, trusted: [] -/
#guard_msgs in
run_elab do
  let t ← elabType (← `(List (Nat → Nat)))
  let (_, trusted) ← costedInstance t
  logInfo m!"first order: {← isFirstOrder t}, trusted: {trusted}"

structure Pair where
  a : Nat
  b : Nat

/-- A hand-written instance, which the derivation refuses until it is registered. -/
instance instCostedPair : Costed Pair := Costed.firstOrder Pair

/--
error: efficient: the `Costed` instance `Zcash.Meta.Tests.Instrument.instCostedPair`, which `Pair`
resolves to, is not registered, so the derivation does not trust it. An instance written by hand is
a trusted assumption about cost; register it with
`register_costed Zcash.Meta.Tests.Instrument.instCostedPair` to say so
-/
#guard_msgs (whitespace := lax) in
run_elab do
  discard <| costedInstance (mkConst ``Pair)

register_costed instCostedPair

/-- info: first order: true, trusted: [Zcash.Meta.Tests.Instrument.instCostedPair] -/
#guard_msgs in
run_elab do
  let t ← elabType (← `(List Pair))
  let (_, trusted) ← costedInstance t
  logInfo m!"first order: {← isFirstOrder t}, trusted: {trusted}"

/--
error: register_costed: `Zcash.Meta.Tests.Instrument.instCostedPair` is already registered as
hand-written
-/
#guard_msgs (whitespace := lax) in
register_costed instCostedPair

/-- error: register_costed: `Nat.succ` is not a `Costed` instance -/
#guard_msgs in
register_costed Nat.succ

/--
error: efficient: no `Costed` instance for `Prop → Nat`: its costed form is not known. An
inductive type gets one generated by the derivation; a type that the derivation cannot read
needs an instance written by hand and registered with `register_costed`, which is a trusted
assumption about cost
-/
#guard_msgs (whitespace := lax) in
run_elab do
  discard <| costedInstance (← elabType (← `(Prop → Nat)))

/-! ## Generated instances

* The identity instance: for a structure of first-order fields, a value-parametric one, and a
  recursive inductive.
* A mirror: for a structure with a function field, one with a type parameter, the
  oracle-computation monad with its continuation, and a recursive type with a function field.
-/

structure Point where
  x : Nat
  y : Nat

/-- info: first order: true, trusted: [], instance: Point.instCosted -/
#guard_msgs in
run_elab do
  let (inst, trusted) ← ensureCosted (mkConst ``Point)
  logInfo m!"first order: {← isFirstOrder (mkConst ``Point)}, trusted: {trusted}, \
    instance: {inst}"

structure Window (n : Nat) where
  cells : List (Fin n)
  origin : Point

/-- info: first order: true -/
#guard_msgs in
run_elab do
  logInfo m!"first order: {← isFirstOrder (← elabType (← `(Window 4)))}"

inductive Tree where
  | leaf
  | node (l r : Tree) (v : Nat)

/-- info: first order: true -/
#guard_msgs in
run_elab do
  logInfo m!"first order: {← isFirstOrder (← elabType (← `(List Tree)))}"

structure Stepper where
  step : Nat → Nat
  limit : Nat

/-- info: first order: false, instance: Stepper.instCosted -/
#guard_msgs in
run_elab do
  let (inst, _) ← ensureCosted (mkConst ``Stepper)
  logInfo m!"first order: {← isFirstOrder (mkConst ``Stepper)}, instance: {inst}"

-- The mirror: the function field with its instrumented version, the other field as it was.
-- (The costed form is only an inductive type by unfolding, so the mirror's constructors are
-- named rather than written as `⟨…⟩` or `.mk`.)
example : Costed.WithCosts Stepper = Stepper.withCosts := rfl
example (s : Stepper.withCosts) : Stepper := Costed.forget s
example : Costed.forget (T := Stepper) (Stepper.withCosts.mk (Nat.succ, fun n => (1, n + 1)) 7) =
    ⟨Nat.succ, 7⟩ := rfl

-- Consistency: the instrumented version returns the function's results.
example : Costed.Consistent (T := Stepper)
    (Stepper.withCosts.mk (Nat.succ, fun n => (1, n + 1)) 7) :=
  Stepper.withCosts.Consistent.mk _ _ fun _ => rfl

structure Box (α : Type) where
  item : α

-- A type parameter gives a mirror at the parameter's costed form, even at a first-order
-- instantiation, where the mirror is a copy of the type rather than the type itself.
/-- info: first order: false, instance: Box.instCosted -/
#guard_msgs in
run_elab do
  let t ← elabType (← `(Box Nat))
  let (inst, _) ← ensureCosted t
  logInfo m!"first order: {← isFirstOrder t}, instance: {inst}"

example : Costed.forget (T := Box (Nat → Nat))
    (Box.withCosts.mk (Nat.succ, fun n => (1, Nat.succ n))) = ⟨Nat.succ⟩ := rfl

/-- The oracle-computation monad: a continuation inside a constructor. -/
inductive OC (T F α : Type) where
  | pure (a : α)
  | query (t : T) (k : F → OC T F α)

/-- info: first order: false, instance: OC.instCosted -/
#guard_msgs in
run_elab do
  let t ← elabType (← `(OC Nat Bool Nat))
  let (inst, _) ← ensureCosted t
  logInfo m!"first order: {← isFirstOrder t}, instance: {inst}"

-- The mirror's `query` carries the continuation split into three fields: the function, the cost of
-- a call, and the costed form of the computation it continues with, so that the mirror occurs in a
-- function's codomain, as the type does, and not nested in a pair.
example : Costed.WithCosts (OC Nat Bool Nat) = OC.withCosts Nat Bool Nat := rfl
example : Costed.forget (T := OC Nat Bool Nat) (OC.withCosts.pure 5) = .pure 5 := rfl
example : Costed.forget (T := OC Nat Bool Nat)
    (OC.withCosts.query 3 (fun _ => .pure 1) (fun _ => 1) (fun _ => OC.withCosts.pure 1)) =
    .query 3 (fun _ => .pure 1) := rfl

-- Consistency of a `query`: the result of each call erases to the continuation's result, and
-- is consistent itself.
example : Costed.Consistent (T := OC Nat Bool Nat)
    (OC.withCosts.query 3 (fun _ => .pure 1) (fun _ => 1) (fun _ => OC.withCosts.pure 1)) :=
  OC.withCosts.Consistent.query _ _ _ _ trivial (fun _ _ => rfl)
    (fun _ _ => OC.withCosts.Consistent.pure _ trivial)

/-- A recursive type with a function field: the erasure recurses structurally. -/
inductive Shrub where
  | leaf
  | node (l r : Shrub) (f : Nat → Nat)

/-- info: first order: false, instance: Shrub.instCosted -/
#guard_msgs in
run_elab do
  let (inst, _) ← ensureCosted (mkConst ``Shrub)
  logInfo m!"first order: {← isFirstOrder (mkConst ``Shrub)}, instance: {inst}"

example : Costed.forget (T := Shrub)
    (Shrub.withCosts.node .leaf .leaf (id, fun n => (0, n))) = .node .leaf .leaf id := rfl

end Zcash.Meta.Tests.Instrument
