private def certifiedActivations : List (ℕ × ℕ) :=
  placeSelectorTrace actionRegionStartsCertificate (actionSourceSelectorTrace actionConfig)

/-- The ordered source trace equals the retained activation list, connecting the compact certificate
to synthesis. -/
private theorem orderedActivations_eq : actionOrderedSelectorActivations = certifiedActivations :=
  congrArg (fun starts => placeSelectorTrace starts (actionSourceSelectorTrace actionConfig))
    actionOrderedRegionStarts_eq_certificate

set_option maxRecDepth 16384 in
/-- The source certificate contains 6,795 activations, fixing the count consumed by
selector-compression bounds. -/
private theorem certifiedActivations_length : certifiedActivations.length = 6795 := by
  kernel_rfl

set_option maxRecDepth 16384 in
/-- The retained activations produce the certified selector bits, connecting source placement to
compression. -/
private theorem certifiedActivations_bits :
    selectorActivationBits 2048 56 certifiedActivations = actionSelectorBitsCertificate := by
  kernel_rfl

/-- The complete ordered source trace retains all activations, including repetitions. -/
theorem actionOrderedSelectorActivations_length : actionOrderedSelectorActivations.length = 6795 :=
  (congrArg List.length orderedActivations_eq).trans certifiedActivations_length

/-- The source trace and certified placement compute exactly the supplied activation bits. -/
theorem actionOrderedSelectorActivations_bits :
    selectorActivationBits 2048 56 actionOrderedSelectorActivations = actionSelectorBitsCertificate :=
  (congrArg (selectorActivationBits 2048 56) orderedActivations_eq).trans certifiedActivations_bits

set_option maxRecDepth 4096 in
/-- The original greedy compiler packs the complete source data into fifteen columns. -/
theorem actionOrderedSelectorCount_eq_fifteen : actionOrderedSelectorCount = 15 := by
  rw [actionOrderedSelectorCount, selectorPackingCount_eq_bits, selectorBitPackingCount,
    actionOrderedSelectorActivations_bits]
  kernel_rfl

/-- The concrete selector-compression count needed by the Action simulation theorem. -/
theorem actionCircuit_newFixedCols_eq_fifteen : actionCircuit.selectorMap.newFixedCols = 15 :=
  actionCircuit_newFixedCols_eq_orderedCount.trans actionOrderedSelectorCount_eq_fifteen

end Zcash.Snark.ZeroKnowledge
