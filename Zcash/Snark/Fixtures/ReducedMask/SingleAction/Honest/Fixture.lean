as halo2 `Params::commit_lagrange` with `Blind::default () = 1`:
`(∑ i in range coeffs.length, coeffs[i] • gLagrange[i]) + w`. `capturedUrsGLagrange`
lists only the leading generators a captured instance can reach; every later
generator carries a zero padding coefficient (`capturedPublicInstances_within_lagrange`). -/
def commitLagrange (coeffs : List Fp) : G :=
  ((List.range coeffs.length).map
    (fun i => (coeffs.getD i 0).val • capturedUrsGLagrange.getD i 0)).sum + capturedURS.w

/-- The instance commitment the verifier uses, computed per proof and column from the
public inputs — halo2 `verify_proof` derives this from its `instances` argument, not the
VK. `assemble` consumes this in place of the removed `vk.instanceCommitment` field; by
`instance_commitments_derived` it equals the captured commitment the deployed verifier used. -/
def derivedInstanceCommitment (p : Fin shape.numProofs) (i : ℕ) : G :=
  commitLagrange (capturedPublicInstances.getD (p.val * capturedNumInstanceColumns + i) [])

/-- Every captured public-instance column fits within the exported Lagrange prefix, so
`commitLagrange`'s `getD` never substitutes the identity for a needed generator. -/
theorem capturedPublicInstances_within_lagrange :
    capturedPublicInstances.all (fun c => decide (c.length ≤ capturedUrsGLagrange.length)) = true := by native_decide

/-- The captured instance commitments are the `commit_lagrange` of the captured public
inputs: this derives `public inputs → instance commitments` in Lean rather than trusting
`capturedInstanceCommitments` as opaque points (ironwood#65). -/
theorem instance_commitments_derived :
    capturedPublicInstances.map commitLagrange = capturedInstanceCommitments := by native_decide

