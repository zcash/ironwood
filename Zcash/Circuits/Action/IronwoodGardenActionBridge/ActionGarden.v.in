Module ActionGardenZ.

Notation Not := not.

(** ** Explicit integer and field arithmetic

    [Z] is an alias for Rocq's mathematical integers.  The [base*] and
    [scalar*] operations below always reduce modulo the named Pallas modulus;
    no coercion or type-class operation hides which field is in use. *)

Definition Z : Type := BinNums.Z.

Definition pallasBaseModulus : Z :=
  28948022309329048855892746252171976963363056481941560715954676764349967630337.

Definition pallasScalarModulus : Z :=
  28948022309329048855892746252171976963363056481941647379679742748393362948097.

Definition zZero : Z := Z.of_nat 0.
Definition zOne : Z := Z.of_nat 1.
Definition zTwo : Z := Z.of_nat 2.

Definition zAdd (left right : Z) : Z := Z.add left right.
Definition zSub (left right : Z) : Z := Z.sub left right.
Definition zMul (left right : Z) : Z := Z.mul left right.
Definition zNeg (value : Z) : Z := Z.opp value.
Definition zDiv (dividend divisor : Z) : Z := Z.div dividend divisor.
Definition zMod (dividend modulus : Z) : Z := Z.modulo dividend modulus.
Definition zPowNat (base : Z) (exponent : nat) : Z :=
  Z.pow base (Z.of_nat exponent).
Definition zEq (left right : Z) : bool := Z.eqb left right.

Definition inRange (value upperBound : Z) : Prop :=
  Z.le zZero value /\ Z.lt value upperBound.

Definition normalize (modulus value : Z) : Z :=
  zMod value modulus.

Definition addModulo (modulus left right : Z) : Z :=
  normalize modulus (zAdd left right).

Definition subModulo (modulus left right : Z) : Z :=
  normalize modulus (zSub left right).

Definition mulModulo (modulus left right : Z) : Z :=
  normalize modulus (zMul left right).

Definition negModulo (modulus value : Z) : Z :=
  normalize modulus (zNeg value).

Definition baseNormalize (value : Z) : Z :=
  normalize pallasBaseModulus value.

Definition baseAdd (left right : Z) : Z :=
  addModulo pallasBaseModulus left right.

Definition baseSub (left right : Z) : Z :=
  subModulo pallasBaseModulus left right.

Definition baseMul (left right : Z) : Z :=
  mulModulo pallasBaseModulus left right.

Definition baseNeg (value : Z) : Z :=
  negModulo pallasBaseModulus value.

Definition baseEqual (left right : Z) : bool :=
  zEq (baseNormalize left) (baseNormalize right).

Definition baseCanonical (value : Z) : Prop :=
  baseNormalize value = value.

Definition scalarNormalize (value : Z) : Z :=
  normalize pallasScalarModulus value.

Definition scalarAdd (left right : Z) : Z :=
  addModulo pallasScalarModulus left right.

Definition scalarNeg (value : Z) : Z :=
  negModulo pallasScalarModulus value.

Definition scalarCanonical (value : Z) : Prop :=
  scalarNormalize value = value.

Definition baseToScalar (value : Z) : Z :=
  scalarNormalize (baseNormalize value).

Definition modInverse (modulus value : Z) : Z :=
  let reduced := normalize modulus value in
  if zEq reduced zZero then zZero
  else normalize modulus
    (zPowNat reduced (Z.to_nat (zSub modulus zTwo))).

Definition baseInverse (value : Z) : Z :=
  modInverse pallasBaseModulus value.

Definition baseDiv (numerator denominator : Z) : Z :=
  baseMul numerator (baseInverse denominator).

(** ** Affine Pallas points

    Points are explicit pairs of canonical base-field integers.  [(0, 0)] is
    the identity sentinel used by both circuit developments.  [pointAdd] is
    total, but the Action validity predicate records the on-curve and
    Sinsemilla non-degeneracy conditions under which it has the protocol
    interpretation. *)

Record Point : Type := {
  x : Z;
  y : Z;
}.

Definition pointIdentity : Point :=
  {| x := zZero; y := zZero |}.

Definition pointNormalize (point : Point) : Point :=
  {| x := baseNormalize point.(x); y := baseNormalize point.(y) |}.

Definition pointIsIdentity (point : Point) : bool :=
  andb (baseEqual point.(x) zZero) (baseEqual point.(y) zZero).

Definition pointCanonical (point : Point) : Prop :=
  baseCanonical point.(x) /\ baseCanonical point.(y).

Definition pointOnCurve (point : Point) : Prop :=
  let xSquared := baseMul point.(x) point.(x) in
  let xCubed := baseMul xSquared point.(x) in
  let right := baseAdd xCubed (Z.of_nat 5) in
  baseMul point.(y) point.(y) = right.

Definition pointValid (point : Point) : Prop :=
  pointNormalize point = pointIdentity \/ pointOnCurve point.

Definition pointNeg (point : Point) : Point :=
  if pointIsIdentity point then pointIdentity
  else {| x := baseNormalize point.(x); y := baseNeg point.(y) |}.

Definition pointAdd (left right : Point) : Point :=
  if pointIsIdentity left then pointNormalize right
  else if pointIsIdentity right then pointNormalize left
  else if baseEqual left.(x) right.(x) then
    if baseEqual (baseAdd left.(y) right.(y)) zZero then pointIdentity
    else
      let numerator :=
        baseAdd
          (baseMul (Z.of_nat 3) (baseMul left.(x) left.(x)))
          zZero in
      let denominator := baseMul zTwo left.(y) in
      let slope := baseDiv numerator denominator in
      let resultX :=
        baseSub (baseSub (baseMul slope slope) left.(x)) right.(x) in
      let resultY :=
        baseSub (baseMul slope (baseSub left.(x) resultX)) left.(y) in
      {| x := resultX; y := resultY |}
  else
    let numerator := baseSub right.(y) left.(y) in
    let denominator := baseSub right.(x) left.(x) in
    let slope := baseDiv numerator denominator in
    let resultX :=
      baseSub (baseSub (baseMul slope slope) left.(x)) right.(x) in
    let resultY :=
      baseSub (baseMul slope (baseSub left.(x) resultX)) left.(y) in
    {| x := resultX; y := resultY |}.

Fixpoint pointNatMul (scalar : nat) (point : Point) : Point :=
  match scalar with
  | O => pointIdentity
  | S remaining => pointAdd (pointNatMul remaining point) point
  end.

Definition scalarMul (scalar : Z) (point : Point) : Point :=
  pointNatMul (Z.to_nat (scalarNormalize scalar)) point.

Definition basePointMul (baseValue : Z) (point : Point) : Point :=
  pointNatMul (Z.to_nat (baseNormalize baseValue)) point.

Definition extractX (point : Point) : Z :=
  if pointIsIdentity point then zZero else baseNormalize point.(x).

(** ** Poseidon P128Pow5T3

    The constants are data in [PoseidonParameters].  The schedule is four full
    rounds, twenty-eight pairs of partial rounds, and four final full rounds,
    matching the 64-round Orchard coreNullifier permutation. *)

Record State3 : Type := {
  x0 : Z;
  x1 : Z;
  x2 : Z;
}.

Record Matrix3 : Type := {
  m00 : Z;
  m01 : Z;
  m02 : Z;
  m10 : Z;
  m11 : Z;
  m12 : Z;
  m20 : Z;
  m21 : Z;
  m22 : Z;
}.

Record PoseidonParameters : Type := {
  roundConstant : Z -> State3;
  mds : Matrix3;
}.

Definition basePow5 (value : Z) : Z :=
  let square := baseMul value value in
  baseMul (baseMul square square) value.

Definition matrixApply (matrix : Matrix3) (state : State3) : State3 :=
  {|
    x0 :=
      baseAdd
        (baseAdd
          (baseMul state.(x0) matrix.(m00))
          (baseMul state.(x1) matrix.(m01)))
        (baseMul state.(x2) matrix.(m02));
    x1 :=
      baseAdd
        (baseAdd
          (baseMul state.(x0) matrix.(m10))
          (baseMul state.(x1) matrix.(m11)))
        (baseMul state.(x2) matrix.(m12));
    x2 :=
      baseAdd
        (baseAdd
          (baseMul state.(x0) matrix.(m20))
          (baseMul state.(x1) matrix.(m21)))
        (baseMul state.(x2) matrix.(m22))
  |}.

Definition poseidonFullRound
    (parameters : PoseidonParameters) (round : Z) (state : State3) : State3 :=
  let constants := parameters.(roundConstant) round in
  matrixApply parameters.(mds) {|
    x0 := basePow5 (baseAdd state.(x0) constants.(x0));
    x1 := basePow5 (baseAdd state.(x1) constants.(x1));
    x2 := basePow5 (baseAdd state.(x2) constants.(x2))
  |}.

Definition poseidonPartialPair
    (parameters : PoseidonParameters) (round : Z) (state : State3) : State3 :=
  let firstConstants := parameters.(roundConstant) round in
  let firstMixed := matrixApply parameters.(mds) {|
    x0 := basePow5 (baseAdd state.(x0) firstConstants.(x0));
    x1 := baseAdd state.(x1) firstConstants.(x1);
    x2 := baseAdd state.(x2) firstConstants.(x2)
  |} in
  let secondConstants := parameters.(roundConstant) (zAdd round zOne) in
  matrixApply parameters.(mds) {|
    x0 := basePow5 (baseAdd firstMixed.(x0) secondConstants.(x0));
    x1 := baseAdd firstMixed.(x1) secondConstants.(x1);
    x2 := baseAdd firstMixed.(x2) secondConstants.(x2)
  |}.

Fixpoint iterateIndexedFrom {A : Type}
    (count index : nat) (step : nat -> A -> A) (initial : A) : A :=
  match count with
  | O => initial
  | S remaining =>
      iterateIndexedFrom remaining (S index) step (step index initial)
  end.

Definition iterateIndexed {A : Type}
    (count : nat) (step : nat -> A -> A) (initial : A) : A :=
  iterateIndexedFrom count O step initial.

Definition poseidonPermute
    (parameters : PoseidonParameters) (initial : State3) : State3 :=
  let afterFirstFull :=
    iterateIndexed 4%nat
      (fun index state =>
        poseidonFullRound parameters (Z.of_nat index) state)
      initial in
  let afterPartial :=
    iterateIndexed 28%nat
      (fun index state =>
        poseidonPartialPair parameters
          (Z.of_nat (Nat.add 4%nat (Nat.mul 2%nat index))) state)
      afterFirstFull in
  iterateIndexed 4%nat
    (fun index state =>
      poseidonFullRound parameters
        (Z.of_nat (Nat.add 60%nat index)) state)
    afterPartial.

Definition poseidonHash2
    (parameters : PoseidonParameters) (left right : Z) : Z :=
  let capacity :=
    baseNormalize (zMul (Z.of_nat 2) (zPowNat (Z.of_nat 2) 64%nat)) in
  (** Garden's constant-length-two sponge enters the permutation with the two
      message words already in the state.  This direct form corresponds as a
      total function for arbitrary [Z] inputs. *)
  (poseidonPermute parameters {|
    x0 := left;
    x1 := right;
    x2 := capacity
  |}).(x0).

(** ** Concrete deployed Orchard parameters *)

Definition listGetDAtZ {A : Type}
    (values : PrimArray.array A) (index : Z) (fallback : A) : A :=
  let normalizedIndex := Z.max zZero index in
  if Z.ltb normalizedIndex
      (Uint63.to_Z (PrimArray.length values))
  then PrimArray.get values (Uint63.of_Z normalizedIndex)
  else fallback.

Definition orchardPoseidonRoundConstants : PrimArray.array State3 :=
  actionGardenPoseidonRoundConstantsData.

Definition orchardPoseidonRoundConstant (round : Z) : State3 :=
  listGetDAtZ orchardPoseidonRoundConstants round
    {| x0 := zZero; x1 := zZero; x2 := zZero |}.

Definition orchardPoseidonMds : Matrix3 := {|
  m00 := 4844513277385895547578596669280046666372576567380472439333234012806535256931;
  m01 := 22420227485671588580194914215361958133919537309433003325602272145024023440222;
  m02 := 3505906565384614297249013623188452104971681200991017471148427242055139865693;
