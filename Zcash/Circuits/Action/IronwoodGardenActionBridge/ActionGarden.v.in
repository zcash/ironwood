(** The public Garden layer below refers to the deployed tables through these
    named accessors.  Keeping the storage boundary opaque prevents Rocq's
    library cooker from recursively inlining all 1,088 rows into every helper;
    these remain definitions and proof files may locally mark them
    [Transparent] when auditing concrete entries. *)
Strategy opaque
  [orchardPoseidonRoundConstants
   orchardPoseidonRoundConstant
   orchardPoseidonMds
   orchardPoseidonParameters
   orchardSinsemillaGenerators
   orchardSinsemillaGenerator].

(** ** Garden-shaped Action specification *)

Record Params : Type := {
  paramsNoteCommitQ : Point;
  paramsCommitIvkQ : Point;
  paramsMerkleCrhQ : Point;
}.

Definition orchardParams : Params := {|
  paramsNoteCommitQ := orchardNoteCommitQ;
  paramsCommitIvkQ := orchardCommitIvkQ;
  paramsMerkleCrhQ := orchardMerkleCrhQ
|}.

Definition pointAddGarden (left right : Point) : Point :=
  if zEq left.(x) zZero then right
  else if zEq right.(x) zZero then left
  else if andb (zEq left.(x) right.(x))
      (zEq (baseAdd left.(y) right.(y)) zZero)
  then pointIdentity
  else
    let slope :=
      if zEq left.(x) right.(x)
      then
        baseDiv
          (baseMul (Z.of_nat 3) (baseMul left.(x) left.(x)))
          (baseMul zTwo left.(y))
      else
        baseDiv
          (baseSub right.(y) left.(y))
          (baseSub right.(x) left.(x)) in
    let resultX :=
      baseSub
        (baseSub (baseMul slope slope) left.(x))
        right.(x) in
    {|
      x := resultX;
      y := baseSub
        (baseMul slope (baseSub left.(x) resultX))
        left.(y)
    |}.

Definition extractXGarden (point : Point) : Z :=
  point.(x).

Definition pointAddIncomplete (left right : Point) : Point :=
  let slope :=
    baseDiv
      (baseSub left.(y) right.(y))
      (baseSub left.(x) right.(x)) in
  let resultX :=
    baseSub
      (baseSub (baseMul slope slope) left.(x))
      right.(x) in
  {|
    x := resultX;
    y :=
      baseSub
        (baseMul slope (baseSub left.(x) resultX))
        left.(y)
  |}.

Definition sinsemillaRound (accumulator : Point) (word : Z) : Point :=
  pointAddIncomplete
    (pointAddIncomplete accumulator (orchardSinsemillaGenerator word))
    accumulator.

Definition sinsemillaHashToPointGarden
    (domain : Point) (words : list Z) : Point :=
  fold_left sinsemillaRound words domain.

Definition pointIdentityGarden (point : Point) : Prop :=
  point.(x) = zZero /\ point.(y) = zZero.

Definition sinsemillaRoundDefined
    (accumulator : Point) (word : Z) : Prop :=
  let generator := orchardSinsemillaGenerator word in
  let firstSum := pointAddIncomplete accumulator generator in
  ~ pointIdentityGarden accumulator /\
  ~ pointIdentityGarden generator /\
  baseNormalize accumulator.(x) <> baseNormalize generator.(x) /\
  ~ pointIdentityGarden firstSum /\
  baseNormalize firstSum.(x) <> baseNormalize accumulator.(x).

Fixpoint sinsemillaHashDefinedFromGarden
    (accumulator : Point) (words : list Z) : Prop :=
  match words with
  | nil => True
  | cons word rest =>
      sinsemillaRoundDefined accumulator word /\
      sinsemillaHashDefinedFromGarden
        (sinsemillaRound accumulator word) rest
  end.

Definition sinsemillaHashDefinedGarden
    (domain : Point) (words : list Z) : Prop :=
  sinsemillaHashDefinedFromGarden domain words.

Fixpoint wordsLe (count : nat) (value : Z) : list Z :=
  match count with
  | O => nil
  | S remaining =>
      cons
        (zMod value (zPowNat zTwo 10%nat))
        (wordsLe remaining (zDiv value (zPowNat zTwo 10%nat)))
  end.

Definition pointParity (point : Point) : Z :=
  zMod point.(y) zTwo.

Definition noteCommitMessageGarden
    (gd pkd : Point) (value rho psi : Z) : list Z :=
  wordsLe 109%nat
    (zAdd
      (zAdd
        (zAdd
          (zAdd
            (zAdd
              (zAdd
                (zAdd
                  (zAdd
                    (extractXGarden gd)
                    (zMul (pointParity gd) (zPowNat zTwo 255%nat)))
                  (zMul (extractXGarden pkd) (zPowNat zTwo 256%nat)))
                (zMul (pointParity pkd) (zPowNat zTwo 511%nat)))
              (zMul value (zPowNat zTwo 512%nat)))
            (zMul rho (zPowNat zTwo 576%nat)))
          (zMul psi (zPowNat zTwo 831%nat)))
        zZero)
      zZero).

Definition commitIvkMessageGarden (ak nk : Z) : list Z :=
  wordsLe 51%nat (zAdd ak (zMul nk (zPowNat zTwo 255%nat))).

Definition merkleMessageGarden (layer left right : Z) : list Z :=
  wordsLe 52%nat
    (zAdd layer
      (zAdd
        (zMul left (zPowNat zTwo 10%nat))
        (zMul right (zPowNat zTwo 265%nat)))).

Definition merkleLayer
    (domain : Point) (layer node sibling : Z) (isRight : bool) : Z :=
  let left := if isRight then sibling else node in
  let right := if isRight then node else sibling in
  extractXGarden
    (sinsemillaHashToPointGarden domain
      (merkleMessageGarden layer left right)).

Definition merkleRootGarden
    (domain : Point) (leaf : Z) (path : list (Z * Z * bool)) : Z :=
  fold_left
    (fun node element =>
      merkleLayer domain (fst (fst element)) node
        (snd (fst element)) (snd element))
    path leaf.

Definition merkleStepDefinedGarden
    (domain : Point) (node layer sibling : Z) (isRight : bool) : Prop :=
  let left := if isRight then sibling else node in
  let right := if isRight then node else sibling in
  sinsemillaHashDefinedGarden domain
    (merkleMessageGarden layer left right).

Inductive merklePathDefinedFromGarden
    (domain : Point) : Z -> list (Z * Z * bool) -> Prop :=
  | ActionGardenMerklePathDefinedNil (node : Z) :
      merklePathDefinedFromGarden domain node nil
  | ActionGardenMerklePathDefinedCons
      (node nextNode layer sibling : Z) (isRight : bool)
      (rest : list (Z * Z * bool)) :
      merkleStepDefinedGarden domain node layer sibling isRight ->
      nextNode = merkleLayer domain layer node sibling isRight ->
      merklePathDefinedFromGarden domain nextNode rest ->
      merklePathDefinedFromGarden domain node
        (cons ((layer, sibling), isRight) rest).

Definition merklePathDefinedGarden
    (domain : Point) (leaf : Z)
    (path : list (Z * Z * bool)) : Prop :=
  merklePathDefinedFromGarden domain leaf path.

Fixpoint pathLayersFrom
    (expected : Z) (path : list (Z * Z * bool)) : Prop :=
  match path with
  | nil => True
  | cons element rest =>
      fst (fst element) = expected /\
      pathLayersFrom (zAdd expected zOne) rest
  end.

Definition pathLayersCanonical
    (path : list (Z * Z * bool)) : Prop :=
  pathLayersFrom zZero path.

Record ActionInputs : Type := {
  inAk : Point;
  inNk : Z;
  inRhoOld : Z;
  inPsiOld : Z;
  inCmOld : Point;
  inGdOld : Point;
  inPkdOld : Point;
  inVOld : Z;
  inRivk : Z;
  inAlpha : Z;
  inAnchorPublic : Z;
  inRcv : Z;
  inMagnitude : Z;
  inSign : Z;
  inLeaf : Z;
  inPath : list (Z * Z * bool);
  inGdNew : Point;
  inPkdNew : Point;
  inVNew : Z;
  inPsiNew : Z;
  inRcmNew : Z;
}.

Record FullActionInputs : Type := {
  fullAction : ActionInputs;
  fullRcmOld : Z;
  fullEnableSpend : Z;
  fullEnableOutput : Z;
  fullDisableCrossAddress : Z;
}.

Record ActionOutputs : Type := {
  outAnchor : Z;
  outCvNet : Point;
  outNfOld : Z;
  outRk : Point;
  outCmx : Z;
}.

Definition signedNetValue (magnitude sign : Z) : Z :=
  if zEq sign zOne then magnitude else zNeg magnitude.

Definition spendAuthRandomize (ak : Point) (alpha : Z) : Point :=
  pointAddGarden ak (scalarMul alpha orchardSpendAuthG).

Definition valueCommit (value randomness : Z) : Point :=
  pointAddGarden
    (scalarMul value orchardValueCommitVG)
    (scalarMul randomness orchardValueCommitRG).

Definition nullifier (nk rho psi : Z) (cm : Point) : Z :=
  let hash := poseidonHash2 orchardPoseidonParameters nk rho in
  let scalar := baseAdd hash psi in
  extractXGarden
    (pointAddGarden
      (scalarMul scalar orchardNullifierKG)
      cm).

Definition noteCommit
    (parameters : Params)
    (gd pkd : Point) (value rho psi randomness : Z) : Point :=
  pointAddGarden
    (sinsemillaHashToPointGarden parameters.(paramsNoteCommitQ)
      (noteCommitMessageGarden gd pkd value rho psi))
    (scalarMul randomness orchardNoteCommitRG).

Definition commitIvk
    (parameters : Params) (ak nk randomness : Z) : Point :=
  pointAddGarden
    (sinsemillaHashToPointGarden parameters.(paramsCommitIvkQ)
      (commitIvkMessageGarden ak nk))
    (scalarMul randomness orchardCommitIvkRG).

Definition actionParametersValid (parameters : Params) : Prop :=
  pointCanonical parameters.(paramsNoteCommitQ) /\
  pointCanonical parameters.(paramsCommitIvkQ) /\
  pointCanonical parameters.(paramsMerkleCrhQ) /\
  pointCanonical orchardSpendAuthG /\
  pointCanonical orchardValueCommitVG /\
  pointCanonical orchardValueCommitRG /\
  pointCanonical orchardNullifierKG /\
  pointCanonical orchardNoteCommitRG /\
  pointCanonical orchardCommitIvkRG /\
  pointOnCurve parameters.(paramsNoteCommitQ) /\
  pointOnCurve parameters.(paramsCommitIvkQ) /\
  pointOnCurve parameters.(paramsMerkleCrhQ) /\
  pointOnCurve orchardSpendAuthG /\
  pointOnCurve orchardValueCommitVG /\
  pointOnCurve orchardValueCommitRG /\
  pointOnCurve orchardNullifierKG /\
  pointOnCurve orchardNoteCommitRG /\
  pointOnCurve orchardCommitIvkRG /\
  forall word : Z,
    inRange word (Z.of_nat 1024) ->
    pointCanonical (orchardSinsemillaGenerator word) /\
    pointOnCurve (orchardSinsemillaGenerator word).

Definition actionPointsTyped (input : FullActionInputs) : Prop :=
  let core := input.(fullAction) in
  pointCanonical core.(inAk) /\
  pointCanonical core.(inCmOld) /\
  pointCanonical core.(inGdOld) /\
  pointCanonical core.(inPkdOld) /\
  pointCanonical core.(inGdNew) /\
  pointCanonical core.(inPkdNew) /\
  pointOnCurve core.(inAk) /\
  pointValid core.(inCmOld) /\
  pointOnCurve core.(inGdOld) /\
  pointOnCurve core.(inPkdOld) /\
  pointOnCurve core.(inGdNew) /\
  pointOnCurve core.(inPkdNew).

Definition actionBaseValuesTyped (input : FullActionInputs) : Prop :=
  let core := input.(fullAction) in
  baseCanonical core.(inNk) /\
  baseCanonical core.(inRhoOld) /\
  baseCanonical core.(inPsiOld) /\
  baseCanonical core.(inVOld) /\
  baseCanonical core.(inAnchorPublic) /\
  baseCanonical input.(fullEnableSpend) /\
  baseCanonical input.(fullEnableOutput) /\
  baseCanonical input.(fullDisableCrossAddress) /\
  baseCanonical core.(inMagnitude) /\
  baseCanonical core.(inSign) /\
  baseCanonical core.(inLeaf) /\
  baseCanonical core.(inVNew) /\
  baseCanonical core.(inPsiNew).

Definition actionScalarValuesTyped (input : FullActionInputs) : Prop :=
  let core := input.(fullAction) in
  scalarCanonical core.(inRivk) /\
  scalarCanonical core.(inAlpha) /\
  scalarCanonical input.(fullRcmOld) /\
  scalarCanonical core.(inRcmNew) /\
  scalarCanonical core.(inRcv).

Definition actionInputsTyped (input : FullActionInputs) : Prop :=
  actionPointsTyped input /\
  actionBaseValuesTyped input /\
  actionScalarValuesTyped input.

Definition actionRangesValid (input : FullActionInputs) : Prop :=
  let core := input.(fullAction) in
  let twoTo64 := zPowNat zTwo 64%nat in
  let twoTo255 := zPowNat zTwo 255%nat in
  inRange core.(inVOld) twoTo64 /\
  inRange core.(inVNew) twoTo64 /\
  inRange core.(inMagnitude) twoTo64 /\
  (core.(inSign) = zOne \/ core.(inSign) = baseNeg zOne) /\
  inRange core.(inLeaf) twoTo255 /\
  forall element : Z * Z * bool,
    In element core.(inPath) ->
    inRange (snd (fst element)) twoTo255.

Definition actionValueConstraints (input : FullActionInputs) : Prop :=
  let core := input.(fullAction) in
  baseSub core.(inVOld) core.(inVNew) =
    baseMul core.(inMagnitude) core.(inSign) /\
  baseMul core.(inVOld)
    (baseSub zOne input.(fullEnableSpend)) = zZero /\
  baseMul core.(inVNew)
    (baseSub zOne input.(fullEnableOutput)) = zZero /\
  (Not (input.(fullDisableCrossAddress) = zZero) ->
    core.(inGdOld) = core.(inGdNew) /\
    core.(inPkdOld) = core.(inPkdNew)).

Definition actionOwnershipValid
    (parameters : Params) (input : FullActionInputs) : Prop :=
  let core := input.(fullAction) in
  let ivkWords :=
    commitIvkMessageGarden (extractXGarden core.(inAk)) core.(inNk) in
  let oldNoteWords :=
    noteCommitMessageGarden core.(inGdOld) core.(inPkdOld)
      core.(inVOld) core.(inRhoOld) core.(inPsiOld) in
  let ivkPoint :=
    commitIvk parameters
      (extractXGarden core.(inAk)) core.(inNk) core.(inRivk) in
  sinsemillaHashDefinedGarden
    parameters.(paramsCommitIvkQ) ivkWords /\
  core.(inPkdOld) =
    scalarMul (extractXGarden ivkPoint) core.(inGdOld) /\
  sinsemillaHashDefinedGarden
    parameters.(paramsNoteCommitQ) oldNoteWords /\
  core.(inCmOld) =
    noteCommit parameters core.(inGdOld) core.(inPkdOld)
      core.(inVOld) core.(inRhoOld) core.(inPsiOld)
      input.(fullRcmOld).

Definition actionMerkleValid
    (parameters : Params) (input : FullActionInputs) : Prop :=
  let core := input.(fullAction) in
  List.length core.(inPath) = 32%nat /\
  pathLayersCanonical core.(inPath) /\
  merklePathDefinedGarden parameters.(paramsMerkleCrhQ)
    core.(inLeaf) core.(inPath) /\
  core.(inLeaf) = extractXGarden core.(inCmOld) /\
  (core.(inVOld) = zZero \/
    core.(inAnchorPublic) =
      merkleRootGarden parameters.(paramsMerkleCrhQ)
        core.(inLeaf) core.(inPath)).

Definition actionNewNoteValid
    (parameters : Params) (input : FullActionInputs) : Prop :=
  let core := input.(fullAction) in
  let nfOldValue :=
    nullifier core.(inNk) core.(inRhoOld)
      core.(inPsiOld) core.(inCmOld) in
  sinsemillaHashDefinedGarden parameters.(paramsNoteCommitQ)
    (noteCommitMessageGarden core.(inGdNew) core.(inPkdNew)
      core.(inVNew) nfOldValue core.(inPsiNew)).

Definition validActionInputs
    (parameters : Params) (input : FullActionInputs) : Prop :=
  actionParametersValid parameters /\
  actionInputsTyped input /\
  actionRangesValid input /\
  actionValueConstraints input /\
  actionOwnershipValid parameters input /\
  actionMerkleValid parameters input /\
  actionNewNoteValid parameters input.

Definition orchardAction
    (parameters : Params) (input : ActionInputs) : ActionOutputs :=
  let nfOldValue :=
    nullifier input.(inNk) input.(inRhoOld)
      input.(inPsiOld) input.(inCmOld) in
  {|
    outAnchor :=
      if zEq input.(inVOld) zZero
      then input.(inAnchorPublic)
      else
        merkleRootGarden parameters.(paramsMerkleCrhQ)
          input.(inLeaf) input.(inPath);
    outCvNet :=
      valueCommit
        (signedNetValue input.(inMagnitude) input.(inSign))
        input.(inRcv);
    outNfOld := nfOldValue;
    outRk := spendAuthRandomize input.(inAk) input.(inAlpha);
    outCmx :=
      extractXGarden
        (noteCommit parameters input.(inGdNew) input.(inPkdNew)
          input.(inVNew) nfOldValue input.(inPsiNew) input.(inRcmNew))
  |}.

End ActionGardenZ.
